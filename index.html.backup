<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CloudSync Pro - Distributed Cloud Storage</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .animate-pulse-dot {
            animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
        }
    </style>
</head>
<body class="bg-gray-50">
    <div id="app"></div>

    <script>
        const API_BASE = 'http://localhost:5000/api';
        
        // App State
        let state = {
            isAuthenticated: false,
            currentView: 'login',
            currentUser: null,
            files: [],
            nodes: [],
            uploadProgress: null,
            showOtpModal: false,
            otpEmail: '',
            adminAuthenticated: false,
            adminToken: ''
        };

        // Utility Functions
        function formatBytes(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB', 'TB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        // API Functions
        async function apiCall(endpoint, method = 'GET', data = null) {
            const options = {
                method,
                headers: { 'Content-Type': 'application/json' }
            };
            if (data) options.body = JSON.stringify(data);

            const response = await fetch(`${API_BASE}${endpoint}`, options);
            return await response.json();
        }

        // Auth Functions
        async function handleSignup(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
                username: formData.get('username'),
                email: formData.get('email'),
                password: formData.get('password'),
                phone: formData.get('phone') || ''
            };

            const result = await apiCall('/auth/signup', 'POST', data);
            if (result.success) {
                alert('✅ Signup successful! You may connect to your account now.');
                state.currentView = 'login';
                render();
            } else {
                alert('❌ ' + (result.error || 'Signup failed'));
            }
        }

        async function handleLogin(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
                email: formData.get('email'),
                password: formData.get('password')
            };

            const result = await apiCall('/auth/login', 'POST', data);
            if (result.success) {
                alert('✅ OTP sent to ' + data.email);
                state.otpEmail = data.email;
                state.showOtpModal = true;
                render();
            } else {
                alert('❌ ' + (result.error || 'Login failed'));
            }
        }

        async function handleVerifyOtp(e) {
            e.preventDefault();
            const formData = new FormData(e.target);
            const data = {
                email: state.otpEmail,
                otp: formData.get('otp')
            };

            const result = await apiCall('/auth/verify-otp', 'POST', data);
            if (result.success) {
                state.isAuthenticated = true;
                state.currentUser = result.user;
                state.showOtpModal = false;
                state.currentView = 'dashboard';
                await loadUserData();
                render();
            } else {
                alert('❌ ' + (result.error || 'OTP verification failed'));
            }
        }

        async function loadUserData() {
            // Load files using UID if present
            const uid = state.currentUser.uid || state.currentUser.email;
            const filesResult = await apiCall(`/files/list/${uid}`);
            state.files = filesResult.files || [];
            state.quota = filesResult.quota || (30 * 1024 * 1024 * 1024);

            // Load nodes (admin may see them)
            const nodesResult = await apiCall('/nodes/status');
            state.nodes = nodesResult.nodes || [];
        }

        async function handleFileUpload(e) {
            const file = e.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('file', file);
            formData.append('uid', state.currentUser.email);

            state.uploadProgress = { fileName: file.name, progress: 0 };
            render();

            try {
                // Simulate progress
                for (let i = 0; i <= 100; i += 10) {
                    state.uploadProgress.progress = i;
                    render();
                    await new Promise(resolve => setTimeout(resolve, 200));
                }

                const response = await fetch(`${API_BASE}/files/upload`, {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    await loadUserData();
                    state.uploadProgress = null;
                    render();
                    alert('✅ File uploaded successfully!');
                } else {
                    throw new Error(result.error);
                }
            } catch (error) {
                state.uploadProgress = null;
                alert('❌ Upload failed: ' + error.message);
                render();
            }
        }

        async function deleteFile(fileId) {
            if (!confirm('Delete this file?')) return;

            const result = await apiCall(`/files/delete/${fileId}?uid=${state.currentUser.email}`, 'DELETE');
            if (result.success) {
                await loadUserData();
                render();
                alert('✅ File deleted successfully!');
            } else {
                alert('❌ ' + (result.error || 'Delete failed'));
            }
        }

        async function downloadFile(fileId, fileName) {
            try {
                const resp = await fetch(`${API_BASE}/files/download/${fileId}?uid=${state.currentUser.email}`);
                if (!resp.ok) throw new Error('Download failed');

                const blob = await resp.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = fileName || 'download';
                document.body.appendChild(a);
                a.click();
                a.remove();
                window.URL.revokeObjectURL(url);
            } catch (err) {
                alert('❌ ' + (err.message || 'Download failed'));
            }
        }

        // Admin functions
        async function adminAddNode() {
            const name = prompt('Enter node name (optional)');
            const result = await apiCall('/nodes/add', 'POST', { name: name || '' });
            if (result.success) {
                alert('Node added');
                await loadUserData(); render();
            } else alert('Error: ' + (result.error || 'Failed'));
        }

        async function adminDeleteNode(id) {
            if (!confirm('Delete node ' + id + '?')) return;
            const result = await apiCall(`/nodes/delete/${id}`, 'DELETE');
            if (result.success) { alert('Deleted'); await loadUserData(); render(); }
            else alert('Error: ' + (result.error || 'Failed'));
        }

        async function adminFetchUsers() {
            const res = await apiCall('/admin/users');
            return res.users || [];
        }

        async function adminPromote(uid) {
            const res = await apiCall(`/admin/users/vip/${uid}`, 'POST');
            if (res.success) { alert('Promoted'); await loadUserData(); render(); }
            else alert('Error: ' + (res.error || 'Failed'));
        }

        async function adminDemote(uid) {
            const res = await apiCall(`/admin/users/vip/${uid}`, 'DELETE');
            if (res.success) { alert('Demoted'); await loadUserData(); render(); }
            else alert('Error: ' + (res.error || 'Failed'));
        }

        async function sendAiPrompt() {
            const prompt = document.getElementById('ai-prompt').value;
            if (!prompt) return alert('Enter a prompt');
            const res = await apiCall('/ai/assistant', 'POST', { prompt });
            if (res.response) document.getElementById('ai-response').textContent = res.response;
            else alert('AI error: ' + (res.error || ''));
        }

        function logout() {
            if (confirm('Logout?')) {
                state = {
                    isAuthenticated: false,
                    currentView: 'login',
                    currentUser: null,
                    files: [],
                    nodes: [],
                    uploadProgress: null,
                    showOtpModal: false,
                    otpEmail: ''
                };
                render();
            }
        }

        // Render Functions
        function renderLoginPage() {
            return `
                <div class="min-h-screen bg-gradient-to-br from-blue-900 via-purple-900 to-indigo-900 flex items-center justify-center p-4">
                    <div class="bg-white/10 backdrop-blur-lg rounded-2xl shadow-2xl p-8 w-full max-w-md border border-white/20">
                        <div class="text-center mb-8">
                            <div class="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-br from-blue-500 to-purple-500 rounded-full mb-4 shadow-lg">
                                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                                </svg>
                            </div>
                            <h1 class="text-3xl font-bold text-white mb-2">CloudSync Pro</h1>
                            <p class="text-blue-200">Distributed Cloud Storage Platform</p>
                        </div>

                        <div class="flex mb-6 bg-white/5 rounded-lg p-1">
                            <button onclick="state.currentView='login'; render();" 
                                class="flex-1 py-2 rounded-md transition-all ${state.currentView === 'login' ? 'bg-blue-500 text-white shadow-lg' : 'text-white/70'}">
                                Login
                            </button>
                            <button onclick="state.currentView='signup'; render();" 
                                class="flex-1 py-2 rounded-md transition-all ${state.currentView === 'signup' ? 'bg-blue-500 text-white shadow-lg' : 'text-white/70'}">
                                Sign Up
                            </button>
                        </div>

                        ${state.currentView === 'signup' ? renderSignupForm() : renderLoginForm()}
                    </div>

                    ${state.showOtpModal ? renderOtpModal() : ''}
                </div>
            `;
        }

        function renderSignupForm() {
            return `
                <form onsubmit="handleSignup(event)" class="space-y-4">
                    <input type="text" name="username" required placeholder="Username" 
                        class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <input type="email" name="email" required placeholder="Email" 
                        class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <input type="password" name="password" required placeholder="Password" 
                        class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <input type="tel" name="phone" placeholder="Phone (optional)" 
                        class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <button type="submit" 
                        class="w-full py-3 bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 text-white rounded-lg font-semibold transition-all shadow-lg">
                        Create Account
                    </button>
                </form>
            `;
        }

        function renderLoginForm() {
            return `
                <form onsubmit="handleLogin(event)" class="space-y-4">
                    <input type="email" name="email" required placeholder="Email" 
                        class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <input type="password" name="password" required placeholder="Password" 
                        class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-lg text-white placeholder-white/50 focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <button type="submit" 
                        class="w-full py-3 bg-gradient-to-r from-blue-500 to-purple-500 hover:from-blue-600 hover:to-purple-600 text-white rounded-lg font-semibold transition-all shadow-lg">
                        Login
                    </button>
                </form>
            `;
        }

        function renderOtpModal() {
            return `
                <div class="fixed inset-0 bg-black/50 backdrop-blur-sm flex items-center justify-center p-4 z-50">
                    <div class="bg-white rounded-2xl p-8 w-full max-w-md shadow-2xl">
                        <h2 class="text-2xl font-bold mb-4">Verify OTP</h2>
                        <p class="text-gray-600 mb-4">Enter the 6-digit code sent to ${state.otpEmail}</p>
                        <form onsubmit="handleVerifyOtp(event)" class="space-y-4">
                            <input type="text" name="otp" maxlength="6" required placeholder="000000" 
                                class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg text-center text-2xl tracking-widest focus:outline-none focus:ring-2 focus:ring-blue-500">
                            <div class="flex gap-3">
                                <button type="button" onclick="state.showOtpModal=false; render();" 
                                    class="flex-1 py-3 bg-gray-200 hover:bg-gray-300 rounded-lg font-semibold">
                                    Cancel
                                </button>
                                <button type="submit" 
                                    class="flex-1 py-3 bg-blue-500 hover:bg-blue-600 text-white rounded-lg font-semibold">
                                    Verify
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            `;
        }

        function renderDashboard() {
            const totalStorage = state.quota || (30 * 1024 * 1024 * 1024);
            const usedStorage = state.files.reduce((sum, f) => sum + f.size, 0);

            return `
                <div class="min-h-screen bg-gray-50">
                    <header class="bg-white border-b border-gray-200 shadow-sm">
                        <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between">
                            <div class="flex items-center gap-3">
                                <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-purple-500 rounded-lg flex items-center justify-center">
                                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
                                    </svg>
                                </div>
                                <div>
                                    <h1 class="text-xl font-bold">CloudSync Pro</h1>
                                    <p class="text-xs text-gray-500">${state.currentUser.email}</p>
                                </div>
                            </div>
                            <button onclick="logout()" class="px-4 py-2 bg-red-500 hover:bg-red-600 text-white rounded-lg">
                                Logout
                            </button>
                        </div>
                    </header>

                    <div class="max-w-7xl mx-auto px-4 py-6">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
                            <div class="bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-xl shadow-lg p-6">
                                <p class="text-sm mb-2">Storage Used</p>
                                <p class="text-2xl font-bold">${formatBytes(usedStorage)}</p>
                                <p class="text-xs">of ${formatBytes(totalStorage)}</p>
                                <div class="mt-3 bg-blue-400 rounded-full h-2">
                                    <div class="bg-white rounded-full h-2" style="width: ${(usedStorage / totalStorage * 100).toFixed(1)}%"></div>
                                </div>
                            </div>
                            
                            <div class="bg-gradient-to-br from-green-500 to-green-600 text-white rounded-xl shadow-lg p-6">
                                <p class="text-sm mb-2">Total Files</p>
                                <p class="text-2xl font-bold">${state.files.length}</p>
                                <p class="text-xs">Across all nodes</p>
                            </div>
                            
                            <!-- Active Nodes removed from UI (users should not see node internals) -->
                        </div>

                        ${state.uploadProgress ? `
                            <div class="bg-white border-2 border-blue-500 rounded-xl p-6 shadow-lg mb-6">
                                <p class="font-semibold mb-2">${state.uploadProgress.fileName}</p>
                                <div class="w-full bg-gray-200 rounded-full h-3">
                                    <div class="bg-blue-600 h-3 rounded-full" style="width: ${state.uploadProgress.progress}%"></div>
                                </div>
                                <p class="text-sm text-gray-600 mt-2">${state.uploadProgress.progress}% complete</p>
                            </div>
                        ` : ''}

                        <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="text-lg font-semibold">Upload Files</h3>
                                <label class="px-4 py-2 bg-blue-500 hover:bg-blue-600 text-white rounded-lg cursor-pointer">
                                    Choose File
                                    <input type="file" onchange="handleFileUpload(event)" class="hidden">
                                </label>
                            </div>
                        </div>

                        <div class="bg-white rounded-xl shadow-sm">
                            <div class="p-6 border-b">
                                <h3 class="text-lg font-semibold">My Files (${state.files.length})</h3>
                            </div>
                            <div class="divide-y">
                                ${state.files.length === 0 ? `
                                    <div class="p-12 text-center text-gray-500">
                                        <p>No files uploaded yet</p>
                                    </div>
                                ` : state.files.map(file => `
                                    <div class="p-4 hover:bg-gray-50 flex items-center justify-between">
                                        <div>
                                            <p class="font-semibold">${file.name}</p>
                                            <p class="text-sm text-gray-500">${formatBytes(file.size)}</p>
                                        </div>
                                        <div class="flex gap-2">
                                            <button onclick="downloadFile(${file.id}, '${file.name.replace(/'/g, "\'") }')" class="p-2 text-blue-600 hover:bg-blue-100 rounded-lg">
                                                Download
                                            </button>
                                            <button onclick="deleteFile(${file.id})" class="p-2 text-red-500 hover:bg-red-100 rounded-lg">
                                                Delete
                                            </button>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                        
                        ${state.currentUser.role === 'admin' ? renderAdminPanel() : ''}
                    </div>
                </div>
            `;
        }

        function renderAdminPanel() {
            // Admin view: nodes, users, AI assistant
            const nodesHtml = state.nodes.map(n => `
                <div class="p-3 border rounded-lg flex items-center justify-between">
                    <div>
                        <p class="font-semibold">${n.name} (ID: ${n.id})</p>
                        <p class="text-sm text-gray-500">IP: ${n.ip} • Status: ${n.status} • Storage: ${ (n.storage.total/(1024**3)).toFixed(1) } GB</p>
                    </div>
                    <div class="flex gap-2">
                        <button onclick="adminDeleteNode(${n.id})" class="px-3 py-1 bg-red-500 text-white rounded">Delete</button>
                    </div>
                </div>
            `).join('');

            // Fetch users and render placeholder div, then populate
            setTimeout(async () => {
                const users = await adminFetchUsers();
                const container = document.getElementById('admin-users');
                if (!container) return;
                container.innerHTML = users.map(u => `
                    <div class="p-2 border rounded flex items-center justify-between">
                        <div>
                            <p class="font-semibold">${u.email} (${u.uid})</p>
                            <p class="text-sm text-gray-500">Role: ${u.role} • Used: ${formatBytes(u.storage_used)} • Quota: ${formatBytes(u.quota)}</p>
                        </div>
                        <div class="flex gap-2">
                            ${u.role === 'vip' ? `<button onclick="adminDemote('${u.uid}')" class='px-2 py-1 bg-yellow-500 text-white rounded'>Demote</button>` : `<button onclick="adminPromote('${u.uid}')" class='px-2 py-1 bg-green-600 text-white rounded'>Promote VIP</button>`}
                        </div>
                    </div>
                `).join('');
            }, 50);

            return `
                <div class="max-w-7xl mx-auto px-4 py-6">
                    <h2 class="text-xl font-bold mb-4">Admin Dashboard</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
                        <div class="bg-white rounded-xl p-6 shadow">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="font-semibold">Nodes (${state.nodes.length})</h3>
                                <button onclick="adminAddNode()" class="px-3 py-1 bg-green-600 text-white rounded">Add Node</button>
                            </div>
                            <div class="space-y-3">${nodesHtml}</div>
                        </div>

                        <div class="bg-white rounded-xl p-6 shadow">
                            <div class="flex items-center justify-between mb-4">
                                <h3 class="font-semibold">Users</h3>
                            </div>
                            <div id="admin-users" class="space-y-3">
                                <p class="text-sm text-gray-500">Loading users...</p>
                            </div>
                        </div>
                    </div>

                    <div class="bg-white rounded-xl p-6 shadow">
                        <h3 class="font-semibold mb-2">AI Assistant</h3>
                        <p class="text-sm text-gray-500 mb-4">Ask the assistant about storage, files or send a prompt.</p>
                        <div class="flex gap-2">
                            <input id="ai-prompt" class="flex-1 px-3 py-2 border rounded" placeholder="Ask something...">
                            <button onclick="sendAiPrompt()" class="px-4 py-2 bg-blue-600 text-white rounded">Send</button>
                        </div>
                        <pre id="ai-response" class="mt-4 bg-gray-100 p-3 rounded"></pre>
                    </div>
                </div>
            `;
        }

        function render() {
            const app = document.getElementById('app');
            app.innerHTML = state.isAuthenticated ? renderDashboard() : renderLoginPage();
        }

        // Initial render
        render();
    </script>
</body>
</html>